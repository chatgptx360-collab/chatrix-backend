# =====================================================
# Chatrix — Root Environment (copy to .env)
# Per-app overrides live in apps/<app>/.env
# =====================================================

NODE_ENV=development

# ----- Database -----
DATABASE_URL=postgresql://chatrix:chatrix@localhost:5432/chatrix
POSTGRES_USER=chatrix
POSTGRES_PASSWORD=chatrix
POSTGRES_DB=chatrix

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Backend -----
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000

# Public URL of the web client — used to build verify/reset email links.
WEB_APP_URL=http://localhost:3000

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-me-with-strong-random-string
JWT_REFRESH_SECRET=replace-me-with-strong-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Argon2 (password hashing)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Email (SMTP — for verification + password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Chatrix <noreply@chatrix.app>"

# ----- Storage (pick one) -----
STORAGE_DRIVER=supabase            # supabase | s3 | local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=chatrix-media

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=chatrix-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----- Web (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Mobile (Expo) -----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000

# ----- Push Notifications -----
EXPO_ACCESS_TOKEN=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_CONTACT=mailto:admin@chatrix.app

# ----- Rate limiting -----
RATE_LIMIT_GLOBAL_RPM=600
RATE_LIMIT_AUTH_RPM=20

# ----- Admin -----
ADMIN_BOOTSTRAP_EMAIL=admin@chatrix.app
