{
  "name": "@chatrix/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Chatrix iOS + Android client (Expo).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "echo 'Mobile builds run via EAS — see docs/deploy-mobile.md'",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "echo 'test: mobile (no tests yet)'",
    "clean": "rm -rf .expo .turbo"
  },
  "dependencies": {
    "@chatrix/shared": "workspace:*",
    "@chatrix/ui": "workspace:*",
    "expo": "~51.0.39",
    "expo-router": "~3.5.24",
    "expo-status-bar": "~1.12.1",
    "expo-secure-store": "~13.0.2",
    "expo-haptics": "~13.0.1",
    "expo-image": "~1.13.0",
    "expo-image-picker": "~15.0.7",
    "expo-document-picker": "~12.0.2",
    "expo-av": "~14.0.7",
    "expo-file-system": "~17.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-constants": "~16.0.2",
    "expo-notifications": "~0.28.18",
    "expo-system-ui": "~3.0.7",
    "expo-blur": "~13.0.2",
    "expo-clipboard": "~6.0.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "lucide-react-native": "^0.454.0",
    "@tanstack/react-query": "^5.59.0",
    "socket.io-client": "^4.8.0",
    "zustand": "^4.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.7",
    "@types/react": "~18.2.79",
    "typescript": "^5.6.3"
  }
}
