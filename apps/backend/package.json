{
  "name": "@chatrix/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Chatrix API + realtime gateway (NestJS / Fastify / Socket.IO).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "tsx src/main.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap-admin": "tsx src/db/bootstrap-admin.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@chatrix/shared": "file:../../packages/shared",
    "tsx": "^4.19.1",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.39",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "argon2": "^0.41.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "zod": "^3.23.8",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
